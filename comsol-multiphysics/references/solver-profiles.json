{
  "comsol": {
    "preferred_profile": "comsol-batch-local-auto",
    "profiles": [
      {
        "name": "comsol-batch-local-auto",
        "status": "example",
        "type": "command",
        "bin_discovery_order": [
          "COMSOL_BIN",
          "COMSOL_ROOT",
          "COMSOL_HOME",
          "PATH:comsolbatch.exe",
          "Windows common install roots",
          "Linux common install roots"
        ],
        "batch_executable": "comsolbatch.exe",
        "compiler_executable": "comsolcompile.exe",
        "verification": "Run scripts/probe_comsol.ps1 locally before trusting this profile."
      },
      {
        "name": "comsol-mph-python-runtime",
        "status": "runtime",
        "type": "python_mph",
        "python_discovery_order": [
          "explicit user path",
          "COMSOL_MPH_PYTHON",
          "PYTHON",
          "active virtual environment",
          "system PATH"
        ],
        "adapter": "scripts/comsol_mph_tool.py",
        "runtime": "scripts/comsol_mcp_runtime",
        "verification": "Use a Python environment with mph and mcp installed, then run scripts/comsol_mph_tool.py list-tools."
      }
    ]
  }
}
